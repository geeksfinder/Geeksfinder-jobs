# TEMPLATE ONLY — this file is committed to git. Put real values in .env.local (git-ignored), never here.
# Anything starting NEXT_PUBLIC_ is visible in the browser — never put secrets there.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only

# AI — Google AI Studio (primary) + Groq (fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite   # tried in order
# GROQ_MODEL=llama-3.3-70b-versatile
AI_DAILY_CALL_CAP=1200               # global denial-of-wallet guard

# Blog writer — Claude or OpenAI, whichever key is set (Claude wins if both; force with ARTICLE_PROVIDER=openai|claude).
# Paid per token; capped at ARTICLES_PER_DAY.
ANTHROPIC_API_KEY=
CLAUDE_USD_PER_MTOK_IN=              # optional: Claude price per million input tokens (default 1), for the anthropic spend cap
CLAUDE_USD_PER_MTOK_OUT=             # optional: per million output tokens (default 5)
USD_INR_RATE=                        # optional: converts AI spend to ₹ for spend caps (default 88)
# CLAUDE_ARTICLE_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
GEMINI_BLOG_API_KEY=                 # optional: separate free Gemini key used only by the blog (else GEMINI_API_KEY)
# OPENAI_ARTICLE_MODEL=gpt-5-mini
ARTICLES_PER_DAY=3
GNEWS_API_KEY=                       # optional extra news source

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=             # long random string; also passed to setWebhook
TELEGRAM_CHANNEL_ID=                 # e.g. @YourChannel — new articles are posted here
ADMIN_TELEGRAM_CHAT_ID=              # optional: where admin alerts go (failed cron, spend caps); default = owners' Telegram
# WhatsApp Cloud API (docs/whatsapp-admin/SPEC.md §3). Server-only: never NEXT_PUBLIC_*.
WHATSAPP_TOKEN=                      # permanent system-user token (whatsapp_business_messaging + _management)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=                 # Meta app secret: checks X-Hub-Signature-256 on every webhook call
WHATSAPP_VERIFY_TOKEN=               # long random string, also typed into Meta's webhook settings
WHATSAPP_GRAPH_VERSION=              # optional, default v23.0
WHATSAPP_TEMPLATE_LANG=              # optional, language code the templates were approved in (default en)
NEXT_PUBLIC_TELEGRAM_CHANNEL=

# Email alerts (Brevo)
BREVO_API_KEY=
EMAIL_FROM=                          # must be a verified sender in Brevo

# Job sources
RAPIDAPI_KEY=                        # subscribe to the JSearch API on RapidAPI
ADZUNA_APP_ID=                       # optional (paid after 25 test calls)
ADZUNA_APP_KEY=

# HR finder (optional)
HUNTER_API_KEY=

# Razorpay (Subscriptions + UPI Autopay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create all four with: npx tsx --env-file=.env.local scripts/razorpay-plans.ts (prints the ids to paste here)
RAZORPAY_PLAN_ID_PRO_15=             # Hustle ₹10 every 15 days:            period=daily,   interval=15, amount=1000
RAZORPAY_PLAN_ID_PRO_30=             # Hustle ₹20 a month:                  period=monthly, interval=1,  amount=2000
RAZORPAY_PLAN_ID_PRO_WA_15=          # Hustle + WhatsApp ₹29 every 15 days: period=daily,   interval=15, amount=2900
RAZORPAY_PLAN_ID_PRO_WA_30=          # Hustle + WhatsApp ₹59 a month:       period=monthly, interval=1,  amount=5900
WHATSAPP_PLAN_LIVE=                  # set to 1 only after the WhatsApp morning digest works; until then WhatsApp plans can't be bought
RAZORPAY_WEBHOOK_SECRET=

# Security
UPSTASH_REDIS_REST_URL=              # rate limiting (free tier); falls back to in-memory in dev
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # Cloudflare Turnstile CAPTCHA on login + free tools
TURNSTILE_SECRET_KEY=                # required in production (fails closed without it)
SUPABASE_AUTH_CAPTCHA=0              # 1 = Supabase checks the Turnstile token (Auth → Bot and abuse protection)
UNSUBSCRIBE_SECRET=                  # long random string; signs one-click email unsubscribe links

# SEO
INDEXNOW_KEY=                        # any 32-char hex string; pings Bing when articles publish
